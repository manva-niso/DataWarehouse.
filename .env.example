# ==============================================================================
# Job Market Pulse - Environment Configuration Template
# Copy this file to .env and provide your actual credentials before running.
# ==============================================================================

# Databricks SQL Warehouse (Free Edition or Enterprise)
DATABRICKS_HOST=dbc-your-id.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_TOKEN=dapi_your_access_token
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=default

# ATS / Job Board APIs (Optional / Configurable)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_QUERY=data engineer
ADZUNA_COUNTRY=in
ADZUNA_PAGES=1

# Optional single board fallback tokens (companies.yaml handles board tokens)
GREENHOUSE_BOARD_TOKEN=
LEVER_COMPANY_SLUG=
RIPPLING_BOARD_SLUG=
