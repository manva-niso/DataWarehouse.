# Job Market Pulse environment template.
# Copy to .env and fill in values. Never commit .env.

# Databricks Free Edition SQL warehouse (Unity Catalog, catalog: workspace)
DATABRICKS_HOST=dbc-xxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
DATABRICKS_TOKEN=dapi...
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=default

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_QUERY=
ADZUNA_COUNTRY=
ADZUNA_PAGES=1

# Keep secret board tokens here when a source requires them.
# Public company slugs belong in config/companies.yaml.
GREENHOUSE_BOARD_TOKEN=
